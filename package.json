{
  "name": "literature-screener",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "Desktop app for screening biomedical literature from PubMed",
  "author": "Literature Screener contributors",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:mac": "electron-vite build && electron-builder --mac --universal --publish never",
    "package:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs",
    "test:live": "LIVE_PUBMED=1 vitest run tests/pubmed-live.test.ts",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "guide": "electron scripts/render-pdf.cjs docs/tester-guide.html \"release/Literature-Screener-tester-guide.pdf\""
  },
  "build": {
    "appId": "org.literaturescreener.app",
    "productName": "Literature Screener",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Literature-Screener-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Literature-Screener-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Literature-Screener-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Literature-Screener-windows-setup.${ext}"
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
